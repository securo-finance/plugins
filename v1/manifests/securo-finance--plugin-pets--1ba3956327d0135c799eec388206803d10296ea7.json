{
  "id": "securo-finance/plugin-pets",
  "name": {
    "en": "Pets",
    "pt-BR": "Pets",
    "pt-PT": "Animais de estimação",
    "es": "Mascotas",
    "fr": "Animaux",
    "de": "Haustiere",
    "it": "Animali domestici"
  },
  "description": {
    "en": "A Pets group with categories and rules for pet stores, food and vets: Petz, Cobasi, Petlove, Chewy, Zooplus and more.",
    "pt-BR": "Um grupo Pets com categorias e regras para pet shop, ração e veterinário: Petz, Cobasi, Petlove, Chewy, Zooplus e outros.",
    "pt-PT": "Um grupo Animais de estimação com categorias e regras para lojas de animais, comida e veterinário: Zooplus, Kiwoko e outros.",
    "es": "Un grupo Mascotas con categorías y reglas para tiendas de mascotas, comida y veterinario: Kiwoko, Zooplus, Chewy y más.",
    "fr": "Un groupe Animaux avec des catégories et des règles pour animaleries, nourriture et vétérinaire : Zooplus, Maxi Zoo et plus.",
    "de": "Eine Gruppe Haustiere mit Kategorien und Regeln für Tierbedarf, Futter und Tierarzt: Fressnapf, Zooplus und mehr.",
    "it": "Un gruppo Animali domestici con categorie e regole per negozi di animali, cibo e veterinario: Arcaplanet, Zooplus e altro."
  },
  "version": "1.0.0",
  "repository": "https://github.com/securo-finance/plugin-pets",
  "license": "AGPL-3.0-only",
  "min_securo_version": "0.19.0",
  "contributes": {
    "category_groups": [
      {
        "key": "pets",
        "name": {
          "en": "Pets",
          "pt-BR": "Pets",
          "pt-PT": "Animais",
          "es": "Mascotas",
          "fr": "Animaux",
          "de": "Haustiere",
          "it": "Animali"
        },
        "icon": "paw-print",
        "color": "#D97706"
      }
    ],
    "categories": [
      {
        "key": "pet-supplies",
        "name": {
          "en": "Pet store & food",
          "pt-BR": "Pet shop e ração",
          "pt-PT": "Loja e comida",
          "es": "Tienda y comida",
          "fr": "Animalerie et nourriture",
          "de": "Tierbedarf & Futter",
          "it": "Negozio e cibo"
        },
        "group": "pets",
        "icon": "dog",
        "color": "#D97706"
      },
      {
        "key": "vet",
        "name": {
          "en": "Vet",
          "pt-BR": "Veterinário",
          "pt-PT": "Veterinário",
          "es": "Veterinario",
          "fr": "Vétérinaire",
          "de": "Tierarzt",
          "it": "Veterinario"
        },
        "group": "pets",
        "icon": "stethoscope",
        "color": "#B45309"
      }
    ],
    "rules": [
      {
        "key": "stores",
        "name": "Pet stores",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "\\bPETZ\\b"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "COBASI"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "PETLOVE"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "PET SHOP"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "PETSHOP"
          },
          {
            "field": "description",
            "op": "regex",
            "value": "\\bPETCO\\b"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "PETSMART"
          },
          {
            "field": "description",
            "op": "regex",
            "value": "\\bCHEWY\\b"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "ZOOPLUS"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "FRESSNAPF"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "MAXI ZOO"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "KIWOKO"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "TIENDANIMAL"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "ARCAPLANET"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "PETS AT HOME"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "pet-supplies"
          }
        ],
        "priority": 20
      },
      {
        "key": "vets",
        "name": "Vets",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "contains",
            "value": "VETERINAR"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "CLINICA VET"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "HOSPITAL VET"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "TIERARZT"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "VETERINAIRE"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "VETERINARY"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "vet"
          }
        ],
        "priority": 20
      }
    ]
  }
}
