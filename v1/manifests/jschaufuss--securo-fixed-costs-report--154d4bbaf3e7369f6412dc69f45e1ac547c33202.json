{
  "id": "jschaufuss/securo-fixed-costs-report",
  "name": "Fixed Costs and Subscriptions",
  "description": "Finds potentially recurring expenses and shows their monthly cost.",
  "version": "1.1.0",
  "repository": "https://github.com/jschaufuss/securo-fixed-costs-report",
  "license": "MIT",
  "min_securo_version": "0.22.0",
  "runtime": {
    "entrypoint": "fixed_costs:plugin"
  },
  "api_scopes": [
    {
      "scope": "transactions:read",
      "purpose": "Recognize recurring expenses from transaction history."
    },
    {
      "scope": "categories:read",
      "purpose": "Exclude ignored and transfer categories."
    }
  ],
  "contributes": {
    "widgets": [
      {
        "key": "recurring-payments",
        "name": {"en": "Recurring payments"},
        "code": true,
        "inputs": ["transactions", "categories"],
        "width": "half",
        "period": "last_12_months"
      },
      {
        "key": "monthly-fixed-costs",
        "name": {"en": "Monthly fixed costs"},
        "code": true,
        "inputs": ["transactions", "categories"],
        "width": "third",
        "period": "last_12_months"
      },
      {
        "key": "annual-fixed-costs",
        "name": {"en": "Annual fixed costs"},
        "code": true,
        "inputs": ["transactions", "categories"],
        "width": "third",
        "period": "last_12_months"
      },
      {
        "key": "recurring-payments-compact",
        "name": {"en": "Recurring payments list"},
        "code": true,
        "inputs": ["transactions", "categories"],
        "width": "third",
        "period": "last_12_months"
      }
    ],
    "reports": [
      {
        "key": "fixed-costs",
        "name": {
          "en": "Fixed costs and subscriptions"
        },
        "code": true,
        "inputs": [
          "transactions",
          "categories"
        ]
      }
    ]
  }
}
